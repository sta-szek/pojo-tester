<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- The library verifies that equals(null) returns false, so passing null is intended. -->
    <Match>
        <Class name="pl.pojo.tester.internal.assertion.equals.EqualAssertions"/>
        <Method name="isNotEqualToNull"/>
        <Bug pattern="EC_NULL_ARG"/>
    </Match>
    <!-- Assertion messages intentionally use a fixed "\n" so the text is identical on every platform. -->
    <Match>
        <Class name="~pl\.pojo\.tester\.internal\.assertion\..*AssertionError"/>
        <Bug pattern="VA_FORMAT_STRING_USES_NEWLINE"/>
    </Match>
    <!-- Internal collaborators intentionally share the (mutable) objects passed in; they are not public API. -->
    <Match>
        <Class name="~pl\.pojo\.tester\.internal\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
